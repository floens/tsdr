/* Layout overview — three layers (default, overlay, status)
 *
 *   ┌────────────────────────────────────────────────────────────┐
 *   │ TunerWidget          (auto height)                         │ default
 *   ├──────┬────────────────────────────────────────────┬────────┤
 *   │ dock │ center (1fr, vertical):                    │ dock   │ default
 *   │ left │   viz-container (1fr)  spectrum, waterfall │ right  │ docks-row
 *   │ panel│   panel-content:bottom (auto, when active) │ panel  │ (1fr)
 *   ├──────┴────────────────────────────────────────────┴────────┤
 *   │ panel-bar            (1 row, full width)                   │ default
 *   ├────────────────────────────────────────────────────────────┤
 *   │ ConsoleWidget        (dock: bottom)                        │ overlay
 *   │   collapsed: 3 rows (border + input + border)              │
 *   │   focused:  14 rows (scrollback + input)                   │
 *   ├────────────────────────────────────────────────────────────┤
 *   │ StatusBar            (1 row)                               │ status
 *   ├────────────────────────────────────────────────────────────┤
 *   │ StatusBar margin     (1 row)                               │
 *   └────────────────────────────────────────────────────────────┘
 *
 * Overlay zone = bottom 5 rows (3 console + 1 statusbar + 1 statusbar margin).
 * Console.margin-bottom: 2 reserves the statusbar zone underneath itself.
 * StatusBar (status layer, highest) paints on top of everything.
 * #main-container is vertical and carries margin-bottom: 5 to keep its whole
 * stack above the overlay zone: docks-row (1fr) + panel-bar (1 row) split the
 * remaining height, so the bar lands exactly one row above the console.
 * When the console is focused (height: 14) it covers the viz area AND the
 * panel-bar; both are on lower layers, so the bar reappears when the console
 * collapses. Kitty images use occlusion detection to avoid rendering under it.
 *
 * Panels (Demod, DecoderOutput, Stats, Performance) are registered in
 * tui/view/panels.py and may live on any edge per UIModel.layout. The active
 * panel on an edge mounts a `panel-content:<edge>` wrapper; the single bottom
 * `panel-bar` (EdgeStrip) lists every docked panel and is the launcher.
 */

/* Custom theme variables (tmm pattern) */
$border-muted: rgb(83, 83, 83);
$prompt-color: rgb(255, 255, 255);
$app-bg: ansi_default;

/* Global Layout. App is created with `ansi_color=True`, which disables
   Textual's default `ANSIToTruecolor` line filter so `ansi_default`
   survives into the output as `\e[49m`. `self.rich_style` propagates
   this through every segment: cells emit no bg SGR and the terminal
   paints its own default bg. Widgets that set explicit Rich `bgcolor`
   on segments (waterfall cells, spectrum Kitty image pixels) still
   paint over this. */
Screen {
    layout: vertical;
    layers: default overlay status;
    background: $app-bg;
}

* {
    background: $app-bg;
}

/* === Dock layout ========================================================== */

/* Vertical: docks-row (1fr) above, panel-bar (1 row) below. margin-bottom: 5
   (not padding) reserves the overlay zone — the bottom 5 rows (3 console +
   1 statusbar + 1 statusbar margin) — for the whole stack. */
#main-container {
    width: 100%;
    height: 1fr;
    layout: vertical;
    margin-bottom: 5;
}

#docks-row {
    width: 100%;
    height: 1fr;
    layout: horizontal;
}

#dock--left, #dock--right {
    height: 100%;
    width: auto;        /* 0 cols when empty; 42 cols when a panel is active */
    layout: horizontal;
    scrollbar-size: 0 0;
}

#dock--left  { border-right: solid $border-muted; }
#dock--right { border-left:  solid $border-muted; }

/* Empty docks (no active panel) drop their separator line so the spectrum
   reaches the screen edge. derive_tree tags the dock with the `empty` class
   whenever it has no children. */
#dock--left.empty, #dock--right.empty { border: none; }

#center {
    width: 1fr;
    height: 100%;
    layout: vertical;
}

#viz-container {
    width: 100%;
    height: 1fr;
    padding: 0;
}

/* The single bottom panel bar — full width, 1 row, lists every docked panel. */
EdgeStrip {
    padding: 0 1;
}
EdgeStrip#panel-bar { width: 100%; height: 1; }
EdgeStrip > .edge-strip--digit  { text-style: bold; }
EdgeStrip > .edge-strip--title  { text-style: dim; }
EdgeStrip > .edge-strip--active { text-style: bold; color: rgb(255, 180, 60); }

/* Panel-content wrappers — fixed-column for L/R, full-width auto-height for
   bottom. Children lay out vertically so multi-widget panels (stats +
   constellation) stack correctly. */
#panel-content--left,
#panel-content--right {
    width: 42;
    height: 1fr;
    layout: vertical;
}

#panel-content--bottom {
    width: 100%;
    height: auto;
    min-height: 8;
    layout: vertical;
}

/* === Console + status overlay ============================================= */

ConsoleWidget {
    dock: bottom;
    width: 100%;
    height: auto;
    border-top: round $border-muted;
    border-bottom: round $border-muted;
    layer: overlay;
    margin-bottom: 2;
}

ConsoleWidget.focused {
    height: 14;
}

#console-history {
    height: 1fr;
    display: none;
    scrollbar-size: 1 1;
}

ConsoleWidget.focused #console-history {
    display: block;
}

#autocomplete-overlay {
    display: none;
    overlay: screen;
    position: absolute;
    height: auto;
    max-height: 12;
    width: auto;
    min-width: 30;
    padding: 0 1;
    border: round $border-muted;
}

#autocomplete-overlay.visible {
    display: block;
}

#command-input {
    width: 1fr;
    height: 1;
    padding: 0;
}

/* Its own 'status' layer (highest) so it paints above
   the ConsoleWidget's margin-bottom region. */
StatusBar {
    dock: bottom;
    height: 1;
    padding: 0 1;
    color: $text-muted;
    layer: status;
    margin-bottom: 1;
}

/* === Global overrides ===================================================== */

/* tmm-style input — remove default Textual border. */
Input {
    border: none !important;
    padding: 0;
}

Input:focus {
    border: none !important;
}

/* === Spectrum / waterfall ================================================= */

SpectrumWidget {
    width: 1fr;
    height: 1fr;
}

WaterfallWidget {
    width: 1fr;
    height: 1fr;
}

/* === Panel widgets ======================================================== */

/* Sidebar-style panels (stats / performance) and the constellation Kitty
   image. Each fills its panel-content wrapper's width. */
StatsWidget,
PerformanceWidget {
    width: 100%;
    height: 1fr;
    padding: 1;
}

ConstellationWidget {
    width: 100%;
    height: auto;
}

/* === Tuner ================================================================ */

TunerWidget {
    width: 100%;
    height: auto;

    #tuner-row {
        width: 100%;
        height: 3;
        layout: horizontal;
    }

    #tuner-left {
        width: 1fr;
        min-width: 52;
        height: 3;
        layout: horizontal;
        align: right middle;
    }

    #tuner-right {
        width: 1fr;
        min-width: 51;
        height: 3;
        layout: horizontal;
        align: left middle;
    }

    #tuner-mode {
        width: 16;
        height: 3;
        content-align: right middle;
        margin: 0 1;
    }

    #tuner-device {
        width: 16;
        height: 3;
        content-align: right middle;
        margin: 0 1;
    }

    #tuner-state {
        width: 14;
        height: 3;
        content-align: right middle;
        margin: 0 1;
    }

    #tuner-frequency {
        width: auto;
        margin: 0 4;
    }

    #tuner-meter {
        width: 32;
        height: 3;
        margin: 0 2 0 1;
    }

    #tuner-clock {
        width: 15;
        height: 3;
        margin: 0 1 0 0;
        content-align: left middle;
    }

    &.stopped {
        #tuner-mode, #tuner-device, #tuner-state,
        #tuner-frequency, #tuner-meter, #tuner-clock {
            text-style: dim;
        }
    }

    &.locked #tuner-frequency {
        color: yellow;
    }
}

/* === Decoder panels ======================================================= */

/* All decoder widgets fill their panel-content wrapper horizontally. They
   set their own min-height so the bottom dock auto-sizes around them. */

RDSWidget {
    width: 100%;
    height: auto;
    min-height: 8;
    padding: 0 1;
    border: round $border-muted;
    layout: horizontal;
}

RDSWidget Static {
    width: 1fr;
    height: auto;
}

RDSWidget #rds-stats {
    width: 16;
    min-width: 14;
}

RDSWidget #rds-main {
    width: 24;
    min-width: 18;
}

TETRAWidget {
    width: 100%;
    height: auto;
    min-height: 9;
    padding: 0 1;
    border: round $border-muted;
    layout: horizontal;
}

TETRAWidget Static {
    width: 1fr;
    height: auto;
}

TETRAWidget #tetra-network {
    width: 32;
    min-width: 18;
    padding: 0 1;
}

TETRAWidget #tetra-slots {
    width: 20;
    min-width: 18;
}

TETRAWidget #tetra-calls {
    width: 32;
    min-width: 24;
}

TETRAWidget #tetra-quality {
    width: 18;
    min-width: 14;
}

DMRWidget {
    width: 100%;
    height: auto;
    min-height: 8;
    padding: 0 1;
    border: round $border-muted;
    layout: horizontal;
}

DMRWidget Static {
    width: 1fr;
    height: auto;
}

DMRWidget #dmr-repeater {
    width: 20;
    min-width: 16;
    padding: 0 1;
}

DMRWidget #dmr-slots {
    width: 28;
    min-width: 22;
}

DMRWidget #dmr-quality {
    width: 18;
    min-width: 14;
}

DABWidget {
    width: 100%;
    height: auto;
    min-height: 6;
    padding: 0 1;
    border: round $border-muted;
    layout: horizontal;
}

DABWidget #dab-station {
    width: 30;
    height: auto;
}

DABWidget #dab-slide-text {
    width: 16;
    height: auto;
}

DABWidget #dab-slide-img {
    width: 18;
    height: 5;
}

DABWidget #dab-info {
    width: 22;
    height: auto;
}

DABWidget #dab-signal {
    width: 24;
    height: auto;
}

DABWidget #dab-services {
    width: 1fr;
    height: auto;
    max-height: 5;
    border: none;
    scrollbar-size: 1 0;
}

SSTVWidget {
    width: 100%;
    height: auto;
    min-height: 8;
    padding: 0 1;
    border: round $border-muted;
    layout: horizontal;
}

SSTVWidget #sstv-status {
    width: 28;
    height: auto;
}

SSTVWidget #sstv-progress {
    width: 22;
    height: auto;
}

SSTVWidget #sstv-image-alt {
    width: 1fr;
    height: auto;
}

SSTVWidget #sstv-image {
    width: 1fr;
    height: 100%;
    min-height: 8;
}

ADSBWidget {
    width: 100%;
    height: 12;
    padding: 0;
    border: round $border-muted;
    layout: horizontal;
}

ADSBWidget #adsb-map {
    width: 1fr;
    height: 100%;
}

ADSBWidget #adsb-table {
    width: auto;
    height: auto;
    overflow-y: auto;
    padding: 0 1;
}

DecoderOutputWidget {
    width: 100%;
    height: 12;
    padding: 0 1;
    border: round $border-muted;
}
